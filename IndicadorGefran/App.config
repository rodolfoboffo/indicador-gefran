<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <appSettings>
        <!--<add key="SerialTransport" value="Managed" />-->
		<add key="SerialTransport" value="Win32" />
        <add key="DebugModeEnabled" value="True" />
        <!-- Espera apos cada byte enviado, em tempos de byte (independe do baud rate; ponto decimal = '.') -->
        <add key="InterByteDelayBytes" value="3" />
    </appSettings>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
    </startup>
</configuration>
