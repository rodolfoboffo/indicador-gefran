<Window x:Name="mainForm" x:Class="IndicadorGefran.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IndicadorGefran"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="397.5" Width="668.8">
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar x:Name="toolbarConnection">
                <Label x:Name="labelToolbarSerialPorts" Content="Porta"></Label>
                <ComboBox x:Name="comboboxSerialPorts" Width="120"
                          ItemsSource="{Binding SerialPortNames}"
                          SelectedItem="{Binding SelectedPortName}"
                          IsEnabled="{Binding IsConnectionSettingsEditable}"></ComboBox>
                <Label x:Name="labelToolbarBaudRate" Content="Taxa de transmissão"></Label>
                <ComboBox x:Name="comboboxBaudrates" Width="120"
                          ItemsSource="{Binding BaudRates}"
                          SelectedItem="{Binding SelectedBaudRate}"
                          IsEnabled="{Binding IsConnectionSettingsEditable}">
                </ComboBox>
                <Button x:Name="buttonStartStop" Command="{Binding StartStopCommand}">
                    <Label Content="{Binding StartStopButtonLabel}"></Label>
                </Button>
                <CheckBox x:Name="checkboxSerialLogging" Content="Log da porta serial" VerticalAlignment="Center" Margin="10,0,0,0"
                          IsChecked="{Binding IsSerialLoggingEnabled}"></CheckBox>
            </ToolBar>
        </ToolBarTray>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="True"></DockPanel>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem HorizontalContentAlignment="Stretch">
                <Border BorderBrush="#A0A0A0" BorderThickness="1,1,0,0">
                    <Border BorderBrush="White" BorderThickness="0,0,1,1">
                        <TextBlock x:Name="textBlockConnectionStatus" Text="{Binding ConnectionStatusText}" Padding="4,1"></TextBlock>
                    </Border>
                </Border>
            </StatusBarItem>
        </StatusBar>
        <DockPanel DockPanel.Dock="Right">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Limpar" Margin="5" Command="{Binding ClearCommand}"></Button>
                <Button Content="Exportar" Margin="5" Command="{Binding ExportCommand}"></Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="5">
                <Label Content="Intervalo" DockPanel.Dock="Left"></Label>
                <TextBox x:Name="textBoxStorageTimerInterval" Width="60" HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                         Text="{Binding StorageIntervalText, UpdateSourceTrigger=PropertyChanged}"></TextBox>
                <Label Content="segundos"></Label>
            </StackPanel>
            <DataGrid x:Name="datagridStorage" AutoGenerateColumns="False" Width="200" IsReadOnly="True" Margin="5"
                      ItemsSource="{Binding Readings}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tempo" Binding="{Binding DisplayTime, StringFormat=\{0:#0.000\}}" />
                    <DataGridTextColumn Header="Valor" Binding="{Binding Value}" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
        <StackPanel Width="400" VerticalAlignment="Center">
            <Label x:Name="labelMainIndicator" Content="{Binding CurrentValue}" FontWeight="Bold" FontSize="72" HorizontalAlignment="Center"></Label>
            <Label x:Name="labelTime" Content="{Binding CurrentTime}" FontWeight="Bold" FontSize="24" HorizontalAlignment="Center"></Label>
        </StackPanel>
    </DockPanel>
</Window>
